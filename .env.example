# Optional production settings

# Public site URL (no trailing slash). Used for sitemap, robots, and share cards.
# Example: https://soroban-arena.vercel.app
NEXT_PUBLIC_SITE_URL=

# Upstash Redis — required for durable scores + races on serverless (Vercel).
# Without these, local/single-server still works via .data/store.json.
# https://upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
